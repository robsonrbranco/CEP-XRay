# ===========================================================================
# CEP-XRay — configuração
#
# Copie para `.env` e ajuste. Obrigatórias: DB_NAME, DB_PASSWORD.
# Para subir a API, também API_JWT_SEGREDO.
# ===========================================================================


# ---------------------------------------------------------------------------
# BANCO DE DADOS (Firebird 3.0)
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3050

# Caminho do .fdb COMO O SERVIDOR o enxerga.
#   Windows .......... C:/CEP-XRay/bd/cep_xray.fdb
#   Docker compose ... /var/lib/firebird/data/cep_xray.fdb
# O ETL constrói em `cep_xray_staging.fdb` e promove por renomeação.
DB_NAME=C:/CEP-XRay/bd/cep_xray.fdb

# Só quando o cliente enxerga o arquivo num caminho diferente do servidor
# (Firebird em container ou noutra máquina). A troca blue-green renomeia
# arquivos, e quem renomeia é o processo Python, não o servidor.
FB_LOCAL_DATA_DIR=

DB_USER=SYSDBA
DB_PASSWORD=sua_senha_aqui

# WIN1252 e não UTF8: medido, de 1.585.108 caracteres não-ASCII na fonte,
# exatamente 2 não cabem em WIN1252. UTF8 cobraria 4 bytes por caractere no
# tamanho declarado da coluna sem acrescentar nada útil.
#
# WIN_PTBR compara IGNORANDO acento e caixa, com o dado guardado fiel:
# quem consulta acha "São Paulo" digitando "sao paulo". É essa propriedade
# que torna as colunas `_SA` da fonte desnecessárias (ver src/db/schema.py).
DB_CHARSET=WIN1252
DB_COLLATION=WIN_PTBR

# fbclient.dll / libfbclient.so. Vazio = procura no PATH.
FB_CLIENT_LIBRARY=C:/Program Files/Firebird/Firebird_3_0/fbclient.dll

# Engine dentro do processo, sem servidor. É o modo do pod de consulta; o ETL
# fala com o servidor. Muda a forma do DSN: embedded exige caminho SEM host.
FB_EMBEDDED=


# ---------------------------------------------------------------------------
# TUNING DE CARGA
# ---------------------------------------------------------------------------

# Só pode ser definido na criação do banco — mudar depois exige gbak.
# Medido no CNPJ-XRay: page_size quase não afeta o tamanho final (1,4 MB de
# diferença em 190 MB entre 4K, 8K e 16K). Como espaço é indiferente, o
# critério é profundidade de índice e leitura sequencial, e aí 16K ganha.
FB_PAGE_SIZE=16384

# Cache do banco em MB. Negativo = percentual da RAM física (-50 = metade).
FB_CACHE_MB=2048

FB_BATCH_SIZE=50000
FB_COMMIT_EVERY=500000

# Processos da carga. A base tem 2,17 milhões de linhas e carrega em poucos
# minutos — o paralelismo aqui compra minutos, não horas. É por ARQUIVO, não
# por bloco como no CNPJ-XRay: aqui tokenizar SQL é trabalho de CPU, e reler
# o arquivo em N workers multiplicaria o parsing por N.
ETL_PROCESSOS=4


# ---------------------------------------------------------------------------
# FONTE
# ---------------------------------------------------------------------------

# Diretório com os 15 arquivos TBL_CEP_<AAMM>_*.sql.
# A competência sai do token no nome do arquivo (2610 = 2026-10, convenção
# AAMM do e-DNE). Mais de um token no mesmo diretório é erro.
OUTPUT_FILES_PATH=./db/firebird-querys

LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Sem valor padrão de propósito: um padrão aqui seria uma chave conhecida
# assinando tokens de produção. Trocá-lo invalida todo token em circulação.
API_JWT_SEGREDO=

# Volumes com ciclos de vida distintos: a base é trocada a cada competência,
# as credenciais são permanentes e o log tem janela de retenção. Manter os três
# separados evita que alguém os encoste no mesmo lugar por conveniência.
API_CREDENCIAIS_DIR=C:/CEP-XRay/creds
API_LOGS_DIR=C:/CEP-XRay/logs-api
API_VALIDADE_TOKEN_S=3600
# 0 = nunca podar automaticamente.
API_RETENCAO_DIAS=0
# Pasta do site compilado pelo Hugo. Vazio = não monta nada.
API_SITE_DIR=


# ---------------------------------------------------------------------------
# PUBLICAÇÃO NO OLYMPUS (src/publicacao/enviar.py)
#
# OLYMPUS_HOST é o alias do ~/.ssh/config, que já carrega usuário e chave.
# ---------------------------------------------------------------------------

OLYMPUS_HOST=olympus
OLYMPUS_USER=root
OLYMPUS_PASTA_FDB=/cep-xray-fdb
OLYMPUS_PASTA_DB=/cep-xray-db
OLYMPUS_NOME_BASE=cep_xray.fdb
OLYMPUS_DEPLOYMENT=hestia
OLYMPUS_NAMESPACE=olympus
OLYMPUS_URL_SAUDE=https://hestia.ecomciencia.com/saude
